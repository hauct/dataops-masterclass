# Copy file này thành `.env` rồi điền giá trị. KHÔNG commit file .env thật lên git.
# (Bài học cốt lõi của buổi 7: secrets không bao giờ nằm trong code/repo.)

# --- Airflow ---
# Sinh key bằng: make fernet
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me-to-a-random-string
# JWT secret cho Task Execution API — phải là chuỗi cố định (đừng để trống), dùng chung mọi container.
AIRFLOW_JWT_SECRET=change-me-to-a-random-jwt-secret

# --- Warehouse (Postgres - stack DWH) ---
WAREHOUSE_USER=dwh
WAREHOUSE_PASSWORD=dwh
WAREHOUSE_DB=analytics

# --- MinIO (object storage - stack Lakehouse) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Grafana ---
GRAFANA_PASSWORD=admin
